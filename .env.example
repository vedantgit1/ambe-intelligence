# ---- Gemini ----------------------------------------------------------------
# Server-side only. Never exposed to the browser bundle.
GEMINI_API_KEY=

# Primary reasoning model (complex analysis, briefs, strategy)
GEMINI_MODEL=gemini-3.7-flash
# Cheaper/faster model for repetitive, low-judgement tasks
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Embedding model used by the retrieval layer
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Optional managed vector database --------------------------------------
# If BOTH are present the PineconeVectorStore adapter is selected instead of
# the in-memory store. The demo never requires these.
PINECONE_API_KEY=
PINECONE_INDEX=
